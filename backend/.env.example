POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cad
POSTGRES_SSL=false
DB_SYNCHRONIZE=false
# Gere uma chave longa e aleatória; não publique o arquivo .env.
JWT_SECRET=troque-por-uma-chave-com-ao-menos-32-caracteres
# Opcional: origem do front quando ele for servido por um servidor local.
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
